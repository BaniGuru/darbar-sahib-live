# LIVE_STREAM_URL=https://live.sgpc.net:8442/;
LIVE_STREAM_URL="https://live.sgpc.net:8443/;stream.mp3"

# Current BaniGuru database with panktis.unicode_speech
BANI_DB_PATH=data/bani.db

# This ASR implementation uses full-window ONNX inference without encoder caches.
PORT=8000
ASR_INTERNAL_WS_URL=ws://127.0.0.1:8000/asr/ws/transcribe

# English translation selection and match retention window for the public page
ENGLISH_TRANSLATION_SOURCE_ID=1
MATCH_HOLD_SECONDS=300
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
LOG_LEVEL=INFO
