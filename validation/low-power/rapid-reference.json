{
  "sections": [
    {
      "start": 4.440000000000055,
      "end": 7.919999999999959,
      "text": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਜਪੰਤਿਆ ਕਛੁ ਨ ਕਹੈ ਜਮਕਾਲੁ"
    },
    {
      "start": 9.052999999999997,
      "end": 12.894898000000012,
      "text": "ਨਾਨਕ ਮਨੁ ਤਨੁ ਸੁਖੀ ਹੋਇ"
    },
    {
      "start": 12.894999999999982,
      "end": 15.715000000000032,
      "text": "ਅੰਤੇ ਮਿਲੈ ਗੋਪਾਲੁ"
    },
    {
      "start": 15.715000000000032,
      "end": 20.587576000000013,
      "text": "ਹਰਿ ਕਾ ਨਾਮੁ ਧਿਆਇ ਕੈ ਹੋਹੁ ਹਰਿਆ ਭਾਈ ਕਰਮ ਲਿਖੰਤੇ ਪਾਈਐ ਏ ਰੁਤੁ ਸਹਾਈ"
    },
    {
      "start": 20.587999999999965,
      "end": 25.441778999999997,
      "text": "ਵਣੁ ਤ੍ਰਿਣੁ ਤ੍ਰਿਭਵਣੁ ਮਉਲਿਆ ਅੰਮ੍ਰਿਤ ਫਲੁ ਪਾਈ ਮਿਲਿ ਸਾਧੂ ਸੁਖੁ ਊਪਜੈ ਲਥੀ ਸਭ ਛਾਈ"
    },
    {
      "start": 25.442000000000007,
      "end": 30.799999999999955,
      "text": "ਨਾਨਕੁ ਸਿਮਰੈ ਏਕੁ ਨਾਮੁ ਫਿਰਿ ਬਹੁੜਿ ਨ ਧਾਈ ਫਿਰਿ ਬਹੁੜਿ ਨ ਧਾਈ"
    },
    {
      "start": 31.440000000000055,
      "end": 48.39999999999998,
      "text": "ਬਸੰਤ ਕੀ ਵਾਰ ਮਹਲੁ ਪੰਜਵਾ ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ਹਰਿ ਕਾ ਨਾਮੁ ਧਿਆਇ ਕੈ ਹੋਹੁ ਹਰਿਆ ਭਾਈ"
    },
    {
      "start": 49.15999999999997,
      "end": 53.696000000000026,
      "text": "ਕਰਮਿ ਲਿਖੰਤੈ ਪਾਈਐ ਇਹ ਰੁਤਿ ਸੁਹਾਈ"
    },
    {
      "start": 53.696000000000026,
      "end": 59.22190699999999,
      "text": "ਵਣੁ ਤ੍ਰਿਣੁ ਤ੍ਰਿਭਵਣੁ ਮਉਲਿਆ ਅੰਮ੍ਰਿਤ ਫਲੁ ਪਾਈ"
    },
    {
      "start": 59.22199999999998,
      "end": 65.10391400000003,
      "text": "ਮਿਲਿ ਸਾਧੂ ਸੁਖੁ ਊਪਜੈ ਲਥੀ ਸਭ ਛਾਈ"
    },
    {
      "start": 65.10400000000004,
      "end": 69.53899999999999,
      "text": "ਨਾਨਕੁ ਸਿਮਰੈ ਏਕੁ ਨਾਮੁ"
    },
    {
      "start": 69.53899999999999,
      "end": 74.75999999999999,
      "text": "ਫਿਰਿ ਬਹੁੜਿ ਨ ਧਾਈ"
    },
    {
      "start": 75.39999999999998,
      "end": 78.571913,
      "text": "ਪੂਰਾ ਪ੍ਰਭੁ ਆਰਾਧਿਆ"
    },
    {
      "start": 78.572,
      "end": 82.91300000000001,
      "text": "ਪੂਰਾ ਜਾ ਕਾ ਨਾਉ"
    },
    {
      "start": 82.91300000000001,
      "end": 86.71600000000001,
      "text": "ਨਾਨਕ ਪੂਰਾ ਪਾਇਆ"
    },
    {
      "start": 86.71600000000001,
      "end": 94.03099999999995,
      "text": "ਪੂਰੇ ਕੇ ਗੁਨ ਗਾਉ ਪੰਜੇ ਬਧੇ ਮਹਾਬਲੀ ਕਰਿ ਸਚਾ ਢੋਆ ਆਪਣੇ ਚਰਣ ਜਪਾਇਅਨੁ ਵਿਚਿ ਦਯੁ ਖੜੋਆ"
    },
    {
      "start": 94.03099999999995,
      "end": 99.00666000000001,
      "text": "ਰੋਗ ਸੋਗ ਸਭਿ ਮਿਟਿ ਗਏ ਨਿਤ ਨਵਾ ਨਿਰੋਆ ਦਿਨੁ ਰੈਣਿ ਨਾਮੁ ਧਿਆਇਦਾ ਫਿਰਿ ਪਾਇ ਨ ਮੋਆ"
    },
    {
      "start": 99.00699999999995,
      "end": 104.93799999999999,
      "text": "ਜਿਸ ਤੇ ਉਪਜਿਆ ਨਾਨਕਾ ਸੋਈ ਫਿਰਿ ਹੋਆ ਸੋਈ ਫਿਰਿ ਹੋਆ"
    },
    {
      "start": 104.93799999999999,
      "end": 108.851,
      "text": "ਪੰਜੇ ਬਧੇ ਮਹਾਬਲੀ ਕਰਿ ਸਚਾ ਢੋਆ"
    },
    {
      "start": 108.851,
      "end": 113.41499999999996,
      "text": "ਆਪਣੇ ਚਰਣ ਜਪਾਇਅਨੁ ਵਿਚਿ ਦਯੁ ਖੜੋਆ"
    },
    {
      "start": 113.41499999999996,
      "end": 118.14099999999996,
      "text": "ਰੋਗ ਸੋਗ ਸਭਿ ਮਿਟਿ ਗਏ ਨਿਤ ਨਵਾ ਨਿਰੋਆ"
    }
  ]
}